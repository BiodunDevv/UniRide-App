{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_EAS_PROJECT_ID": "3c513454-4153-46ea-9605-4420f5cf4abc",
        "GOOGLE_SERVICES_JSON": "./google-services.json"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_EAS_PROJECT_ID": "3c513454-4153-46ea-9605-4420f5cf4abc",
        "GOOGLE_SERVICES_JSON": "./google-services.json"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_EAS_PROJECT_ID": "3c513454-4153-46ea-9605-4420f5cf4abc",
        "GOOGLE_SERVICES_JSON": "./google-services.json"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
